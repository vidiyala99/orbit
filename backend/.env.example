# Orbit backend env. Copy to backend/.env and fill in. Never commit the real .env.
# Only required values live here; everything else has a safe default in code.

# --- Core --------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://orbit:localdev@localhost:5434/orbit
FRONTEND_ORIGIN=http://localhost:3000
# Signs session JWTs AND derives the key that encrypts stored Luma cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
DEMO_LOGIN_ENABLED=true

# --- LLM (OpenAI; one key covers chat + embeddings) ---------------------------
OPENAI_API_KEY=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
RESEND_FROM_EMAIL=
# Comma-separated. Sends to anyone else are refused (hackathon safety rail).
EMAIL_ALLOWLIST=

# --- Memory: HydraDB open-source node (local Docker, ADR-0002) ----------------
HYDRA_BOLT_URI=neo4j://127.0.0.1:7687
HYDRA_TOKEN=local-development-token-32-bytes

# --- Structure: Cognee service (runs as its own process, ADR-0002) ------------
COGNEE_URL=http://127.0.0.1:8000

# --- Insight: hotdata.dev -----------------------------------------------------
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=

# --- Motion: RocketRide (local engine, ADR-0002) ------------------------------
ROCKETRIDE_URI=http://127.0.0.1:5565
ROCKETRIDE_APIKEY=

# Not here on purpose:
# - Rote: authenticated via `rote login` inside WSL
# - Snyk: authenticated via `snyk auth`
# - Luma: per-user session, stored encrypted in the database
