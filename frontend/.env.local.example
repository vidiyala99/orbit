# Copy to frontend/.env.local and fill in. Never commit the real .env.local.

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Show a "Continue with demo account" button on the sign-in page.
# Only enable where the backend also has DEMO_LOGIN_ENABLED=true. Leave unset in production.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
